# SeedStream addon configuration.
# TMDB API key: get from https://www.themoviedb.org/settings/api
SEEDSTREAM_TMDB_API_KEY=your_tmdb_api_key_here
# TVDB API key: get from https://www.thetvdb.com/dashboard/account/apikey
SEEDSTREAM_TVDB_API_KEY=your_tvdb_api_key_here
# Local path or Git URL to the seedstream source checkout.
SEEDSTREAM_BUILD_CONTEXT=/opt/docker/seedstream
