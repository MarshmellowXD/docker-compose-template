# Oracle Cloud Monitor configuration.
# Create an API key in the Oracle Cloud console and fill in these values.
OCI_USER_OCID=
OCI_TENANCY_OCID=
OCI_FINGERPRINT=
OCI_REGION=

# Optional Discord webhook for usage alerts.
DISCORD_WEBHOOK_URL=

# Usage thresholds.
MIN_DAILY_USAGE=0.01
MAX_DAILY_USAGE=0
CURRENCY=$

# Cron schedule for summaries and daily limit checks.
SUMMARY_SCHEDULE=0 0 * * *
DAILY_LIMIT_SCHEDULE=0 0 * * *
