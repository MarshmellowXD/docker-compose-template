# ---------------------------------------------------------
#                       OUTLINE
# ---------------------------------------------------------
# Outline is a fast, collaborative, knowledge base for your team built on React and Node.js.
# It uses Pocket ID as an OIDC provider for authentication.

# Generate secret keys with: openssl rand -hex 32
OUTLINE_SECRET_KEY=your_outline_secret_key_here
OUTLINE_UTILS_SECRET=your_outline_utils_secret_here

# Password for the Outline PostgreSQL database.
OUTLINE_POSTGRES_PASSWORD=your_outline_postgres_password_here

# OIDC client credentials for Outline in Pocket ID.
# Create an OIDC client in Pocket ID for Outline and copy the values here.
OUTLINE_OIDC_CLIENT_ID=your_outline_oidc_client_id_here
OUTLINE_OIDC_CLIENT_SECRET=your_outline_oidc_client_secret_here
