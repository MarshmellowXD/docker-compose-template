# This file is used to configure the gluetun container.
# It is currently setup for ProtonVPN. If you would like to configure gluetun
# for another provider, please see the Gluetun wiki: https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers

VPN_SERVICE_PROVIDER=protonvpn
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=

# Server selection. Region is not usable for ProtonVPN, so use country + city.
# Change these to match your preferred location.
SERVER_COUNTRIES=Netherlands

# Server list updater
# See https://github.com/qdm12/gluetun-wiki/blob/main/setup/servers.md#update-the-vpn-servers-list
UPDATER_PERIOD=24h

# Enable the built-in HTTP/SOCKS5 proxy so other services can route through gluetun.
# The HTTP proxy listens on port 8888 inside the container.
HTTPPROXY=on

# If you want to use OpenVPN instead, change VPN_TYPE to openvpn and set:
# OPENVPN_USER=
# OPENVPN_PASSWORD=
# Get the credentials from here: https://account.proton.me/u/0/vpn/OpenVpnIKEv2
